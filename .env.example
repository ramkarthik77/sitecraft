# Copy to .env for a LOCAL DISPOSABLE team demo.
# These sample tokens are intentionally predictable. Change them before making
# your host accessible to anyone else; never commit your .env or record tokens.

# Signs preview links. Use 32+ random characters (openssl rand -hex 32).
SECRET=change-me-to-a-long-random-string-0123456789

# Seed API tokens created on startup. Anyone with one of these can use that role.
#   admin  — everything, including minting tokens
#   editor — people: edit any branch, merge, publish
#   agent  — Claude Code: edits on branches only, can't merge or publish
# The quick-start demo seed command assumes ADMIN_TOKEN=dev-admin-token.
# If you change it, also change SITECRAFT_TOKEN in the seed/smoke commands.
ADMIN_TOKEN=dev-admin-token
EDITOR_TOKEN=dev-editor-token
AGENT_TOKEN=dev-agent-token

# Let agents merge and publish without a person (off by default).
AGENT_CAN_PUBLISH=false
# Let agents edit main directly (off by default).
AGENT_CAN_EDIT_MAIN=false

# Serve published sites at https://<slug>.<SITES_DOMAIN> (needs wildcard DNS).
# Leave empty to serve them at PUBLIC_URL/s/<slug>.
SITES_DOMAIN=

# Used when running outside Docker (pnpm dev). Docker Compose sets its own.
DATABASE_URL=postgres://sitecraft:sitecraft@localhost:5432/sitecraft
PUBLIC_URL=http://localhost:4000
EDITOR_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
STORAGE_DRIVER=fs
STORAGE_DIR=./data/storage

# -- Website / document import (team Docker demo) ----------------------------
# Chromium is installed in the Docker app image; no host installation needed.
# Dockerfile sets SITECRAFT_IMPORT_CHROMIUM_PATH=/usr/bin/chromium.
# Leave private/loopback URLs BLOCKED; only an isolated test process should
# temporarily enable IMPORT_ALLOW_PRIVATE for synthetic local fixture servers.
IMPORT_ALLOW_PRIVATE=false

# Claude-assisted section classification is explicitly opt-in in the UI.
# When this key is unset or empty, import uses safe deterministic mapping.
# For confidential/regulated documents, only configure an approved endpoint.
SITECRAFT_IMPORT_CLAUDE_API_KEY=
# Optional overrides, used only if AI-assisted import is selected:
# SITECRAFT_IMPORT_CLAUDE_URL=https://api.anthropic.com/v1/messages
# SITECRAFT_IMPORT_CLAUDE_MODEL=claude-sonnet-4-5

# PDF/DOCX raw uploads must be authenticated and confirm reuse rights.
# Imported images remain DRAFT and file imports go to import/* review branches.
# The smoke helper intentionally creates two sample imported sites when invoked
# with SITECRAFT_DEMO_SMOKE=1; never run it against real/team production data.
# The 30-day fictional reviewer credentials are printed by the seed process.
# Save them locally for the walkthrough, but don't paste them into chat or video.
