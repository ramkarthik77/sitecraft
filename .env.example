# Copy to .env and change the tokens before sharing the stack with anyone.

# Signs preview links. Use 32+ random characters (openssl rand -hex 32).
SECRET=change-me-to-a-long-random-string-0123456789

# Seed API tokens created on startup. Anyone with one of these can use that role.
#   admin  — everything, including minting tokens
#   editor — people: edit any branch, merge, publish
#   agent  — Claude Code: edits on branches only, can't merge or publish
ADMIN_TOKEN=dev-admin-token
EDITOR_TOKEN=dev-editor-token
AGENT_TOKEN=dev-agent-token

# Let agents merge and publish without a person (off by default).
AGENT_CAN_PUBLISH=false
# Let agents edit main directly (off by default).
AGENT_CAN_EDIT_MAIN=false

# Serve published sites at https://<slug>.<SITES_DOMAIN> (needs wildcard DNS).
# Leave empty to serve them at PUBLIC_URL/s/<slug>.
SITES_DOMAIN=

# Used when running outside Docker (pnpm dev). Docker Compose sets its own.
DATABASE_URL=postgres://sitecraft:sitecraft@localhost:5432/sitecraft
PUBLIC_URL=http://localhost:4000
EDITOR_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
STORAGE_DRIVER=fs
STORAGE_DIR=./data/storage
