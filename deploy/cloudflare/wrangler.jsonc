{
  // Sitecraft on Cloudflare: one Worker in front of two Containers.
  //   https://sitecraft.guduriphaniram1988.workers.dev       editor, API, /s/<slug> sites
  //   https://sitecraft.guduriphaniram1988.workers.dev/mcp   Claude Code
  // To use your own domain later, see "Use your own domain" in docs/CLOUDFLARE.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitecraft",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  "vars": {
    "APP_HOST": "sitecraft.guduriphaniram1988.workers.dev",
    "APP_INSTANCES": "2",
    "R2_BUCKET": "sitecraft",
    "AGENT_CAN_PUBLISH": "false",
    "AGENT_CAN_EDIT_MAIN": "false"
  },

  "containers": [
    {
      "class_name": "SitecraftApp",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 4
    },
    {
      "class_name": "SitecraftMcp",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "APP", "class_name": "SitecraftApp" },
      { "name": "MCP", "class_name": "SitecraftMcp" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SitecraftApp", "SitecraftMcp"] }],

  // Ping every instance each minute: nobody waits on a cold start, and
  // scheduled publishing runs on time.
  "triggers": { "crons": ["* * * * *"] }
}
