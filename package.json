{
  "name": "sitecraft",
  "private": true,
  "version": "0.1.0",
  "description": "A visual website builder where people and Claude Code edit the same site.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build && pnpm -r --filter ./apps/** run build",
    "dev": "pnpm -r --parallel --filter ./apps/** run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "db:migrate": "pnpm --filter @sitecraft/api run migrate",
    "seed": "pnpm --filter @sitecraft/api run seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
