{
  "name": "@sitecraft/api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@electric-sql/pglite": "0.5.11",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^10.1.7",
    "@sitecraft/renderer": "workspace:*",
    "@sitecraft/schema": "workspace:*",
    "fastify": "^5.2.0",
    "fflate": "0.8.3",
    "node-html-parser": "7.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  }
}
